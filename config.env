# CR6608 OpenWrt 定制配置
# 修改本文件后运行: bash build.sh
# 也可用环境变量覆盖，例如: LAN_IP=192.168.9.2 bash build.sh

# ---------- 版本与目标（已核实，通常无需改动）----------
: "${VERSION:=25.12.6}"
: "${TARGET:=ramips}"
: "${SUBTARGET:=mt7621}"
: "${PROFILE:=xiaomi_mi-router-cr6608}"
: "${IB_ARCH:=Linux-x86_64}"
: "${DOWNLOAD_BASE:=https://downloads.openwrt.org}"

# ---------- 构建输出 ----------
: "${EXTRA_IMAGE_NAME:=cr6608custom}"

# ---------- 首次启动预设 ----------
# 请务必修改 root 密码和 Wi-Fi 密码
: "${ROOT_PASSWORD:=ChangeMe-2026}"
: "${LAN_IP:=192.168.9.1}"
: "${HOST_NAME:=CR6608}"
: "${WIFI_2G_SSID:=CR6608-2.4G}"
: "${WIFI_5G_SSID:=CR6608-5G}"
: "${WIFI_PASSWORD:=ChangeMe-2026}"

# LuCI 语言与主题路径（主题包需在 PACKAGES_BASE/PACKAGES_EXTRA 中）
: "${LUCI_LANG:=zh_cn}"
: "${LUCI_THEME_PATH:=/luci-static/bootstrap}"

# ---------- 软件包清单 ----------
# 25.12.6 默认使用 apk；官方包名已对照官方 mipsel_24kc 仓库核实
: "${PACKAGES_BASE:=luci luci-base luci-theme-bootstrap luci-i18n-base-zh-cn luci-i18n-firewall-zh-cn luci-i18n-package-manager-zh-cn luci-app-firewall luci-app-package-manager wpad-mbedtls ca-certificates curl ip-full tcpdump-mini htop nano zoneinfo-asia}"

# 从官方默认包中移除的项（避免与完整版 wpad 冲突）
: "${PACKAGES_REMOVE:=-wpad-basic-mbedtls}"

# 第三方插件（来自下方 dllkids 25.12 / mipsel_24kc APK 源，包名已核实）:
#   luci-app-passwall       PassWall
#   luci-app-ssr-plus       社区常说的 HelloWorld（fw876/helloworld 源）
#   luci-app-turboacc-any   TurboACC（Flow Offload 前端，配合官方 kmod-nft-offload）
#   luci-app-zerotier       ZeroTier LuCI 前端
#   zerotier                ZeroTier 守护进程
# 说明：第三方源中没有独立的 luci-app-helloworld 包，HelloWorld 即 luci-app-ssr-plus。
# PassWall 与 SSR-Plus 可以同时安装，但运行时只能启用其中一个。
: "${PACKAGES_EXTRA:=luci-app-passwall luci-app-ssr-plus luci-app-turboacc-any luci-app-zerotier zerotier}"

# ---------- 第三方 APK 源 ----------
: "${ENABLE_CUSTOM_FEED:=1}"
: "${CUSTOM_FEED_NAME:=dllkids}"
: "${CUSTOM_FEED_URL:=https://down.dllkids.xyz/openwrt-feed/25.12/mipsel_24kc/packages.adb}"
: "${CUSTOM_FEED_KEY_URL:=https://down.dllkids.xyz/openwrt-feed/keys/dllkids-feed.pub.pem}"
